# Gateway config. The nginx image renders this file with envsubst into /etc/nginx/conf.d/default.conf
# (only variables matching NGINX_ENVSUBST_FILTER are replaced, nginx's own $variables stay).

resolver 127.0.0.11 valid=10s ipv6=off;   # Docker's embedded DNS; re-resolved every 10 s, so replicas appear/disappear

# `resolve` makes nginx track the DNS A records of the service name: every replica of a compose service becomes a server.
# max_fails/fail_timeout = passive health check: one failed attempt takes the replica out for 10 s (until DNS drops it).
upstream node_registry     { zone node_registry 64k;     server node-registry:8080     resolve max_fails=1 fail_timeout=10s; }
upstream fuzzy_inference   { zone fuzzy_inference 64k;   server fuzzy-inference:8080   resolve max_fails=1 fail_timeout=10s; }
upstream operator_feedback { zone operator_feedback 64k; server operator-feedback:8080 resolve max_fails=1 fail_timeout=10s; }
upstream anomaly_assessment{ zone anomaly_assessment 64k; server anomaly-assessment:8080 resolve max_fails=1 fail_timeout=10s; }

# API key -> identity. An unknown or missing key maps to "" (=> 401).
map $http_x_api_key $gw_user {
    default                 "";
    "${ADMIN_API_KEY}"      admin;
    "${ENGINEER_API_KEY}"   engineer;
}
map $gw_user $gw_role {
    default   "";
    admin     admin;
    engineer  engineer;
}
map $request_method $gw_is_write {
    default  1;
    GET      0;
    HEAD     0;
    OPTIONS  0;
}
map $uri $gw_upstream {
    ~^/v1/nodes            node_registry;
    ~^/v1/node-types       node_registry;
    ~^/v1/models           fuzzy_inference;
    ~^/v1/feedback         operator_feedback;
    ~^/v1/suggestions      operator_feedback;
    ~^/v1/alerts           anomaly_assessment;
    default                "";
}
# RBAC: writes to /nodes and /models are admin only; everything else is open to both roles.
map "$gw_role:$gw_is_write:$uri" $gw_forbidden {
    default                              0;
    "~^engineer:1:/api/v1/(nodes|models)"  1;   # $uri is still the public /api/v1/... path here
}

log_format gateway '$remote_addr [$time_local] "$request" $status $body_bytes_sent '
                   'user=$gw_user role=$gw_role client_x_user="$http_x_user" '
                   'upstream=$upstream_addr ustatus=$upstream_status rt=$request_time';
server {
    listen 80;
    access_log /var/log/nginx/access.log gateway;   # replaces the image's default `main` log
    absolute_redirect off;   # relative Location, so redirects keep the published host port (8000, not 80)

    location = /health { return 200 'ok'; }

    # /api/v1/<rest> -> /v1/<rest>; only the listed resources are routed, everything else is 404.
    location ~ ^/api/v1/(nodes|node-types|models|feedback|suggestions|alerts)(/|$) {
        if ($gw_user = "")    { return 401; }
        if ($gw_forbidden)    { return 403; }

        rewrite ^/api(/v1/.*)$ $1 break;

        proxy_pass http://$gw_upstream$uri$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # always overwritten from the verified key: a client-supplied X-User / X-Role never reaches a backend
        proxy_set_header X-User $gw_user;
        proxy_set_header X-Role $gw_role;
        proxy_set_header X-API-Key "";

        proxy_next_upstream error timeout http_502 http_503;
        proxy_next_upstream_tries 3;
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
    }

    # API docs: raw contracts + Swagger UI on the same origin, so "Try it out" calls /api/v1 without CORS.
    location /docs/specs/ {
        alias /usr/share/nginx/contracts/;
        default_type application/yaml;
    }
    location = /docs { return 301 /docs/; }
    location /docs/ {
        set $docs_upstream swagger-ui:8080;   # variable => resolved per request, nginx starts even if swagger-ui is down
        proxy_pass http://$docs_upstream;
    }

    location / { return 404; }

    # nginx-generated errors as RFC 9457 problem+json (errors from backends pass through untouched)
    error_page 401 = @e401;
    error_page 403 = @e403;
    error_page 404 = @e404;
    error_page 502 = @e502;
    error_page 503 = @e503;
    error_page 504 = @e504;

    location @e401 { default_type application/problem+json; return 401 '{"type":"about:blank","title":"Unauthorized","status":401,"detail":"missing or unknown X-API-Key"}'; }
    location @e403 { default_type application/problem+json; return 403 '{"type":"about:blank","title":"Forbidden","status":403,"detail":"your role may not use this method on this resource"}'; }
    location @e404 { default_type application/problem+json; return 404 '{"type":"about:blank","title":"Not Found","status":404,"detail":"no such route"}'; }
    location @e502 { default_type application/problem+json; return 502 '{"type":"about:blank","title":"Bad Gateway","status":502,"detail":"upstream service failed or is down"}'; }
    location @e503 { default_type application/problem+json; return 503 '{"type":"about:blank","title":"Service Unavailable","status":503,"detail":"no live upstream instance"}'; }
    location @e504 { default_type application/problem+json; return 504 '{"type":"about:blank","title":"Gateway Timeout","status":504,"detail":"upstream did not answer in time"}'; }
}
